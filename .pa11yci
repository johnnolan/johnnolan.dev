{
  "defaults": {
    "standard": "WCAG2AA",
    "timeout": 5000,
    "concurrency": 1,
    "hideElements": ".mermaid",
    "runners": ["axe"],
    "ignore": ["frame-tested"],
    "reporters": [
      "cli",
      [
        "json",
        {
          "fileName": "./pa11y-output.json"
        }
      ]
    ],
    "chromeLaunchConfig": {
      "args": ["--no-sandbox", "--disable-setuid-sandbox", "--disable-dev-shm-usage"]
    }
  }
}
