{
  "name": "johnnolan.dev",
  "version": "1.0.0",
  "private": true,
  "repository": "git@github.com:johnnolan/johnnolan.dev.git",
  "author": "John Nolan <me@johnnolan.dev>",
  "license": "MIT",
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "lint:check": "eslint .",
    "lint:fix": "eslint --fix .",
    "lint:spell": "cspell \"**/*.md\"",
    "lint:markdown": "markdownlint \"**/*.md\" --ignore node_modules --ignore docs",
    "fix:markdown": "markdownlint \"**/*.md\" --ignore node_modules --ignore docs --fix",
    "lint:report": "eslint . --output-file eslint_report.json --format json",
    "lint:all": "yarn run lint:check && yarn run lint:spell && yarn run lint:markdown && yarn run format:scss:check && yarn run lint:scss",
    "serve": "eleventy --serve",
    "build": "node scripts/clean-site.mjs && eleventy",
    "pa11y-ci": "node scripts/run-pa11y.mjs",
    "format:scss": "prettier --write \"src/scss/**/*.scss\"",
    "format:scss:check": "prettier --check \"src/scss/**/*.scss\"",
    "lint:scss": "stylelint \"src/scss/**/*.scss\"",
    "test:scss": "node --test tests/scss.test.mjs",
    "test:output": "node --test tests/output.test.mjs",
    "test:content": "node --test tests/markdown.test.mjs tests/collections.test.mjs tests/sitemap.test.mjs tests/article-schema.test.mjs tests/drafts.test.mjs tests/article-defaults.test.mjs tests/date-filters.test.mjs tests/page-metadata.test.mjs tests/toc.test.mjs tests/youtube-embed-titles.test.mjs tests/output-mode.test.mjs tests/verify-site.test.mjs",
    "verify:production": "node scripts/verify-site.mjs production",
    "verify:preview": "node scripts/verify-site.mjs preview"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.6",
    "@11ty/eleventy-img": "7.0.0",
    "@11ty/eleventy-plugin-rss": "3.0.0",
    "@eslint/js": "10.0.1",
    "cheerio": "1.2.0",
    "cspell": "10.3.0",
    "dayjs": "1.11.23",
    "eleventy-plugin-youtube-embed": "1.13.2",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "markdown-it": "15.0.1",
    "markdown-it-anchor": "10.0.0",
    "markdownlint-cli": "0.49.1",
    "pa11y-ci": "4.1.1",
    "prettier": "3.9.6",
    "sass": "1.104.0",
    "stylelint": "17.15.0",
    "stylelint-config-recommended-scss": "17.0.1",
    "wrangler": "4.130.0"
  },
  "type": "module",
  "optionalDependencies": {
    "@img/sharp-libvips-linux-x64": "1.3.3"
  }
}
