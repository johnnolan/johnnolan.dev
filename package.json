{
  "name": "johnnolan.dev",
  "version": "1.0.0",
  "main": "index.js",
  "repository": "git@github.com:johnnolan/johnnolan.dev.git",
  "author": "John Nolan <me@johnnolan.dev>",
  "license": "MIT",
  "scripts": {
    "jshint": "jshint src/",
    "lint:check": "eslint .",
    "lint:fix": "eslint --fix .",
    "lint:spell": "cspell \"**/*.md\"",
    "lint:markdown": "markdownlint \"**/*.md\" --ignore node_modules",
    "fix:markdown": "markdownlint \"**/*.md\" --ignore node_modules --fix",
    "lint:report": "eslint . --output-file eslint_report.json --format json",
    "lint:all": "yarn run lint:check && yarn run lint:spell && yarn run lint:markdown && yarn run format:scss:check && yarn run lint:scss",
    "serve": "eleventy --serve",
    "build": "node scripts/clean-site.mjs && eleventy",
    "pa11y-ci": "pa11y-ci --config .pa11yci '_site/**/*.html'",
    "format:scss": "prettier --write \"src/scss/**/*.scss\"",
    "format:scss:check": "prettier --check \"src/scss/**/*.scss\"",
    "lint:scss": "stylelint \"src/scss/**/*.scss\"",
    "test:scss": "node --test tests/scss.test.mjs",
    "test:content": "node --test tests/markdown.test.mjs tests/collections.test.mjs tests/sitemap.test.mjs tests/article-schema.test.mjs tests/drafts.test.mjs"
  },
  "dependencies": {
    "@11ty/eleventy": "3.1.5",
    "eleventy-plugin-youtube-embed": "1.13.2"
  },
  "devDependencies": {
    "@11ty/eleventy-plugin-inclusive-language": "1.0.3",
    "@11ty/eleventy-plugin-rss": "3.0.0",
    "@eslint/js": "10",
    "cheerio": "1.2.0",
    "cspell": "10.0.0",
    "dayjs": "1.11.20",
    "eslint": "10.3.0",
    "globals": "17.12.0",
    "globby": "16.2.0",
    "htmlencode": "0.0.5",
    "jshint": "2.13.6",
    "markdown-it": "14.1.1",
    "markdown-it-anchor": "9.2.0",
    "markdownlint-cli": "0.48.0",
    "pa11y-ci": "4.1.0",
    "prettier": "3.8.3",
    "sass": "1.99.0",
    "stylelint": "17.15.0",
    "stylelint-config-recommended-scss": "17.0.1"
  }
}
