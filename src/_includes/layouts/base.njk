<!doctype html>
<html lang="en">
  {% set pageMeta = {
    title: title,
    description: description,
    image: image,
    pageUrl: page.url,
    isArticle: category,
    date: date,
    updated: updated
  } | pageMetadata(site) %}
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap" rel="stylesheet">
    
    <link href="{{ '/assets/main.css' | url }}{% if cssHash %}?v={{ cssHash }}{% endif %}" rel="stylesheet" as="style">
    <link rel="canonical" href="{{ pageMeta.canonicalUrl }}" />
    <link rel="alternate" type="application/atom+xml" title="{{ site.name }}" href="{{ site.url }}/feed.xml" />

    <link rel="apple-touch-icon" sizes="180x180" href="{{ '/assets/images/apple-touch-icon.png' | url }}">
    <link rel="icon" type="image/png" href="{{ '/assets/images/favicon-32x32.png' | url }}" sizes="32x32">
    <link rel="icon" type="image/png" href="{{ '/assets/images/favicon-16x16.png' | url }}" sizes="16x16">
    <link rel="manifest" href="{{ '/manifest.json' | url }}">
    <link rel="mask-icon" href="{{ '/assets/images/safari-pinned-tab.svg' | url }}" color="#5bbad5">
    <meta name="theme-color" content="#ffffff">

    <link rel="shortcut icon" href="{{ '/favicon.ico' | url }}" type="image/x-icon">

    <meta name="description" content="{{ pageMeta.description }}">

    <meta property="og:title" content="{{ pageMeta.title }}" />
    <meta property="og:url" content="{{ pageMeta.canonicalUrl }}" />
    <meta property="og:description" content="{{ pageMeta.description }}" />
    <meta property="og:image" content="{{ pageMeta.imageUrl }}" />
    <meta property="og:type" content="{{ pageMeta.openGraphType }}" />
    {% if pageMeta.datePublished %}<meta property="article:published_time" content="{{ pageMeta.datePublished }}" />{% endif %}
    {% if pageMeta.dateModified %}<meta property="article:modified_time" content="{{ pageMeta.dateModified }}" />{% endif %}

    <script src="{{ '/assets/index.js' | url }}" defer></script>
    <title>{{ pageMeta.title }} - {{ site.name }}</title>
    
  </head>
  <body>
    <script type="application/ld+json">{{ pageMeta.jsonLd | safeJson | safe }}</script>
    {%- from "../macros/header.njk" import header %}
    {%- from "../macros/navigation.njk" import navigation %}
    {%- from "../macros/footer.njk" import footer %}
    {%- from "../macros/categoryList.njk" import categoryList %}
    {%- from "../macros/cookieBanner.njk" import cookieBanner %}

    {% block body %}
      {{ cookieBanner() }}
      <div class="page-content">
        {% block content %}
          
          {{ header({ siteName: site.name }) }}

          {% set githubIcon %}<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path fill="#181717" d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.385-1.333-1.754-1.333-1.754-1.089-.744.084-.729.084-.729 1.205.084 1.838 1.237 1.838 1.237 1.07 1.834 2.807 1.304 3.492.997.108-.775.42-1.305.763-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.467-2.381 1.235-3.221-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23a11.5 11.5 0 0 1 3-.405c1.02.005 2.045.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.911 1.23 3.221 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>{% endset %}

          {% set linkedinIcon %}<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path fill="#0A66C2" d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>{% endset %}

          {% set rssIcon %}<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><rect width="24" height="24" rx="5" fill="#f26522"/><circle cx="6.18" cy="17.82" r="2.18" fill="#ffffff"/><path d="M4 4v3.5A12.5 12.5 0 0 1 16.5 20H20A16 16 0 0 0 4 4z" fill="#ffffff"/><path d="M4 10.5v3.5A6 6 0 0 1 10 20h3.5A9.5 9.5 0 0 0 4 10.5z" fill="#ffffff"/></svg>{% endset %}

          {% set navigationLinks = (categories.items | reverse).concat([
            { name: "GitHub", url: "https://github.com/" + site.githubName, openInNewWindow: true, icon: githubIcon },
            { name: "LinkedIn", url: site.linkedinUrl, openInNewWindow: true, icon: linkedinIcon },
            { name: "RSS", url: site.url + "/feed.xml", icon: rssIcon }
          ]) %}
          {% if mastheadTitle %}
            {{ categoryList(navigationLinks) }}
          {% else %}
            {{ navigation(navigationLinks) }}
          {% endif %}
          
          <main class="wrapper" role="main" id="content">

            {{ content | safe }}
            
          </main>

        {% endblock %}
      </div>

        {{ footer({ githubName: site.githubName, linkedinUrl: site.linkedinUrl, siteDescription: site.description }) }}

    {% endblock %}
    {% if mermaid %}{% mermaid_js %}{% endif %}
  </body>
</html>
