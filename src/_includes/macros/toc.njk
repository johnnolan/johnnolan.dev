{% macro toc(content) %}
{% set tocContent = content | toc %}
{% if tocContent %}
<details class="toc">
    <summary>
        <span class="toc__summary">
            Table of Contents
        </span>
    </summary>
    <div>
        <nav aria-label="Contents" role="navigation">
            {{ tocContent | safe }}
        </nav>
    </div>
</details>
{% endif %}
{% endmacro %}
