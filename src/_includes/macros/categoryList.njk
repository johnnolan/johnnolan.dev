{% macro categoryList(links) %}
    <div class="articles articles--categories">
        <div class="wrapper">
            <div class="post-list post-list--category">
                {%- for article in links -%}
                    <article class="article--category">
                        <a href="{{ article.url }}"{% if article.openInNewWindow %} target="_blank" rel="noopener noreferrer"{% endif %} aria-label="{{ article.name }}" class="post-list-item-link{% if article.icon %} post-list-item-link--icon{% endif %}">
                            <h2 class="post-link">
                                {% if article.icon %}<span class="nav_list-item_icon">{{ article.icon | safe }}</span>{% else %}{{ article.name }}{% endif %}
                            </h2>
                        </a>
                    </article>
                {%- endfor -%}
            </div>
        </div>
    </div>
{% endmacro %}
